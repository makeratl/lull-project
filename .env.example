# Copy to .env.local (a Neon dev branch) or .env.production.local (production). Both are git-ignored.
# On Vercel, the Neon integration (Storage) sets DATABASE_URL, NEON_AUTH_BASE_URL and VITE_NEON_AUTH_URL per branch.
# Each Neon branch needs its Data API enabled (Neon Console › Data API); the app derives its URL from the auth URL.

# Browser (public; baked into the bundle at build time)
VITE_NEON_AUTH_URL=             # https://ep-….neonauth.<region>.aws.neon.tech/neondb/auth

# Server only (Vercel functions + scripts). Never prefix with VITE_.
DATABASE_URL=                   # Neon pooled connection string (owner; bypasses RLS)
NEON_AUTH_BASE_URL=             # same value as VITE_NEON_AUTH_URL
APP_ORIGIN=https://lull.makeratl.com

# scripts/bootstrap-admin.ts
ADMIN_EMAIL=steven@makeratl.com
ADMIN_NAME=Steven
# ADMIN_PASSWORD=               # optional; otherwise a one-time password is printed

# Daily nudges (Web Push). Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=          # baked into the app
VAPID_PUBLIC_KEY=               # same value, for the server
VAPID_PRIVATE_KEY=              # server only
VAPID_SUBJECT=mailto:you@example.com
NUDGE_SECRET=                   # random; also the GitHub repository secret NUDGE_SECRET (see .github/workflows/nudge.yml)
