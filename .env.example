# Copy to .env.local (local Supabase stack) or .env.production.local (hosted project).
# Both are git-ignored. On Vercel, set the first four in Project → Settings → Environment Variables.

# Browser (public; baked into the bundle at build time)
VITE_SUPABASE_URL=              # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=         # publishable (sb_publishable_…) or legacy anon key

# Server only (Vercel functions + scripts). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=      # secret (sb_secret_…) or legacy service_role key
APP_ORIGIN=https://lull.makeratl.com

# Supabase CLI (link + db push). Not needed on Vercel.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=          # personal access token, supabase.com/dashboard/account/tokens

# scripts/bootstrap-admin.ts
ADMIN_EMAIL=steven@makeratl.com
ADMIN_NAME=Steven
# ADMIN_PASSWORD=               # optional; otherwise a one-time password is printed
